#!/bin/bash

MINISHELL_PATH="../minishell"
VALGRIND_LOG_FILE="./tmp_valgrind-out.txt"
VALGRIND_ENABLED=0
VALGRIND_OK=0
VALGRIND_KO=0
TEST_CASE_FILTER=()

resolve_test_target() {
	local target="$1"

	if [[ -f $target ]]; then
		printf '%s\n' "$target"
		return 0
	fi
	if [[ -f "./$target" ]]; then
		printf '%s\n' "./$target"
		return 0
	fi
	return 1
}

parse_case_filters() {
	local raw="$1"
	local old_ifs="$IFS"
	local selector

	IFS=','
	read -r -a selectors <<< "$raw"
	IFS="$old_ifs"
	for selector in "${selectors[@]}"; do
		[[ $selector =~ ^[0-9]+$ ]] && TEST_CASE_FILTER+=("$selector")
	done
}

should_run_case() {
	local case_index="$1"
	local selected_case

	[[ ${#TEST_CASE_FILTER[@]} -eq 0 ]] && return 0
	for selected_case in "${TEST_CASE_FILTER[@]}"; do
		[[ $selected_case == "$case_index" ]] && return 0
	done
	return 1
}

configure_runner_args() {
	local arg
	local has_valgrind=0
	local has_log_file=0

	RUNNER_ARGS=("$@")
	for arg in "${RUNNER_ARGS[@]}"; do
		[[ $arg == "valgrind" ]] && has_valgrind=1
		[[ $arg == "--log-file" || $arg == --log-file=* ]] && has_log_file=1
	done
	VALGRIND_ENABLED=$has_valgrind
	if [[ $has_valgrind -eq 1 && $has_log_file -eq 0 ]]; then
		RUNNER_ARGS+=("--log-file=$VALGRIND_LOG_FILE")
	fi
}

build_minishell_cmd() {
	MINISHELL_CMD=("${RUNNER_ARGS[@]}" "$MINISHELL_PATH")
	printf -v MINISHELL_CMD_STR '%q ' "${MINISHELL_CMD[@]}"
	MINISHELL_CMD_STR=${MINISHELL_CMD_STR% }
}

parse_valgrind_result() {
	local errors=0
	local definitely_lost=0
	local possibly_lost=0
	local indirectly_lost=0

	VALGRIND_RESULT=""
	VALGRIND_FAILED=0
	[[ $VALGRIND_ENABLED -eq 0 ]] && return
	if [[ ! -f $VALGRIND_LOG_FILE ]]; then
		VALGRIND_RESULT="missing log"
		VALGRIND_FAILED=1
		return
	fi
	errors=$(awk '/ERROR SUMMARY:/ {gsub(/,/, "", $4); value=$4} END {print value+0}' "$VALGRIND_LOG_FILE")
	definitely_lost=$(awk '/definitely lost:/ {gsub(/,/, "", $4); value=$4} END {print value+0}' "$VALGRIND_LOG_FILE")
	possibly_lost=$(awk '/possibly lost:/ {gsub(/,/, "", $4); value=$4} END {print value+0}' "$VALGRIND_LOG_FILE")
	indirectly_lost=$(awk '/indirectly lost:/ {gsub(/,/, "", $4); value=$4} END {print value+0}' "$VALGRIND_LOG_FILE")
	if [[ $errors -eq 0 && $definitely_lost -eq 0 && $possibly_lost -eq 0 && $indirectly_lost -eq 0 ]]; then
		VALGRIND_RESULT="clean"
		return
	fi
	VALGRIND_RESULT="err=$errors def=$definitely_lost poss=$possibly_lost ind=$indirectly_lost"
	VALGRIND_FAILED=1
}

sanitize_minishell_output() {
	if [[ $VALGRIND_ENABLED -eq 1 ]]; then
		grep -vE '^(LD_PRELOAD|VALGRIND_LAUNCHER|VALGRIND_LIB)='
	else
		cat
	fi
}

# Run a specific test if the file name was specified
if [[ $1 == "--" ]]; then
	shift
fi

test_target="$1"
case_filter_arg=""
if [[ -n $test_target && $test_target == *:* ]]; then
	test_target_name=${test_target%%:*}
	test_target_filter=${test_target#*:}
	if resolve_test_target "$test_target_name" >/dev/null; then
		test_target="$test_target_name"
		case_filter_arg="$test_target_filter"
	fi
fi

resolved_test_target=""
if [[ -n $test_target ]]; then
	resolved_test_target=$(resolve_test_target "$test_target")
fi

if [[ -n $resolved_test_target ]]; then
	test_lists=(
		"$resolved_test_target"
	)
	selected_test=$(basename "$resolved_test_target")
	shift
else
	test_lists=(
		"builtins"
		"pipes"
		"redirects"
		"extras"
	)
	selected_test=""
fi

if [[ $selected_test == "wildcards" || $selected_test == "bonus" ]]; then
	MINISHELL_PATH="../minishell_bonus"
fi

if [[ -n $case_filter_arg ]]; then
	parse_case_filters "$case_filter_arg"
fi
while [[ $1 =~ ^[0-9]+$ ]]; do
	TEST_CASE_FILTER+=("$1")
	shift
done

configure_runner_args "$@"
build_minishell_cmd

BOLD="\e[1m"
YELLOW="\033[0;33m"
GREY="\033[38;5;244m"
PURPLE="\033[0;35m"
BLUE="\033[0;36m"
RED="\e[0;31m"
END="\033[0m"

chmod 000 ./test_files/invalid_permission
mkdir ./outfiles
mkdir ./mini_outfiles
mkdir ./bash_outfiles

printf $RED
echo "🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥";
echo "                                                                                             ";
echo " ██    ██ █ ██    █ █ █████ █   █ █████ █     █       ██████ █████ █████ ██████ █████ █████  ";
echo " ███  ███ █ ███   █ █ █     █   █ █     █     █         ██   █     █       ██   █     █   ██ ";
echo " █ ████ █ █ █ ██  █ █ █████ █████ ████  █     █         ██   ████  █████   ██   ████  █████  ";
echo " █  ██  █ █ █  ██ █ █     █ █   █ █     █     █         ██   █         █   ██   █     █   ██ ";
echo " █      █ █ █   ███ █ █████ █   █ █████ █████ █████     ██   █████ █████   ██   █████ █   ██ ";
echo "                                                                                             ";
echo "🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥🔥";
echo "                                                                                              ";

PROMPT=$(echo -e "\nexit\n" | "${MINISHELL_CMD[@]}" | sed "s/\x1B\[[0-9;]\{1,\}[A-Za-z]//g" | grep -v '^exit$' | head -n 1)
[[ -z "$PROMPT" ]] && PROMPT="__NO_MINISHELL_PROMPT__"
# Helper commands:
REMOVE_COLORS="sed s/\x1B\[[0-9;]\{1,\}[A-Za-z]//g"
REMOVE_EXIT="grep -v ^exit$"

for testfile in ${test_lists[*]}; do

	printf $RED
	echo ———————————— $testfile

	while read teste; do
		((i++))
		if ! should_run_case "$i"; then
			continue
		fi

		rm -rf ./outfiles/*
		rm -rf ./mini_outfiles/*
		rm -f "$VALGRIND_LOG_FILE"
		MINI_OUTPUT=$(echo -e "$teste" | "${MINISHELL_CMD[@]}" 2> /dev/null | $REMOVE_COLORS | grep -vF "$PROMPT" | $REMOVE_EXIT | sanitize_minishell_output)
		MINI_OUTFILES=$(cp ./outfiles/* ./mini_outfiles &>/dev/null)
		MINI_EXIT_CODE=$(echo -e "$MINISHELL_CMD_STR\n$teste\necho \$?\nexit\n" | bash 2> /dev/null | $REMOVE_COLORS | grep -vF "$PROMPT" | $REMOVE_EXIT | tail -n 1)
		MINI_ERROR_MSG=$(trap "" PIPE && echo "$teste" | "${MINISHELL_CMD[@]}" 2>&1 > /dev/null | grep -o '[^:]*$' )
		parse_valgrind_result

		rm -rf ./outfiles/*
		rm -rf ./bash_outfiles/*
		BASH_OUTPUT=$(echo -e "$teste" | bash 2> /dev/null)
		BASH_EXIT_CODE=$(echo $?)
		BASH_OUTFILES=$(cp ./outfiles/* ./bash_outfiles &>/dev/null)
		BASH_ERROR_MSG=$(trap "" PIPE && echo "$teste" | bash 2>&1 > /dev/null | grep -o '[^:]*$' | head -n1)

		OUTFILES_DIFF=$(diff --brief ./mini_outfiles ./bash_outfiles)

		printf $YELLOW
		printf "Test %3s: " $i
		if [[ "$MINI_OUTPUT" == "$BASH_OUTPUT" && "$MINI_EXIT_CODE" == "$BASH_EXIT_CODE" && -z "$OUTFILES_DIFF" ]]; then
			printf ✅
			((ok++))
			if [ "$MINI_ERROR_MSG" != "$BASH_ERROR_MSG" ]; then
				printf "⚠️ "
			fi
		else
			printf ❌
		fi
		if [[ $VALGRIND_ENABLED -eq 1 ]]; then
			if [[ $VALGRIND_FAILED -eq 0 ]]; then
				printf " [vg:ok]"
				((VALGRIND_OK++))
			else
				printf " [vg:%s]" "$VALGRIND_RESULT"
				((VALGRIND_KO++))
			fi
		fi
		printf "$GREY $teste \n$END"
		if [ "$OUTFILES_DIFF" ]; then
			echo "$OUTFILES_DIFF"
			echo mini outfiles:
			cat ./mini_outfiles/*
			echo bash outfiles:
			cat ./bash_outfiles/*
		fi
		if [ "$MINI_OUTPUT" != "$BASH_OUTPUT" ]; then
			echo mini output = \($MINI_OUTPUT\)
			echo bash output = \($BASH_OUTPUT\)
		fi
		if [ "$MINI_EXIT_CODE" != "$BASH_EXIT_CODE" ]; then
			echo mini exit code = $MINI_EXIT_CODE
			echo bash exit code = $BASH_EXIT_CODE
		fi
		if [ "$MINI_ERROR_MSG" != "$BASH_ERROR_MSG" ]; then
			echo mini error = \($MINI_ERROR_MSG\)
			echo bash error = \($BASH_ERROR_MSG\)
		fi
	done < "$testfile"
done

chmod 666 ./test_files/invalid_permission
rm -rf ./outfiles
rm -rf ./mini_outfiles
rm -rf ./bash_outfiles
rm -f "$VALGRIND_LOG_FILE"

printf $PURPLE
printf $BOLD
echo   $ok/$i
printf $END
if [[ $VALGRIND_ENABLED -eq 1 ]]; then
	printf $BLUE
	echo "valgrind clean=$VALGRIND_OK issues=$VALGRIND_KO"
	printf $END
fi

if [[ "$ok" == "$i" ]]; then
	echo "🎊 🎊 🎊"
	echo "😎 😎 😎"
	echo "🎉 🎉 🎉"
	exit 0
else
	echo "😭 😭 😭"
	exit 1
fi
